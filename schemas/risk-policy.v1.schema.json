{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuuJiawei/stoat/schemas/risk-policy.v1.schema.json",
  "title": "Stoat risk exception policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exceptions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "rule_ids", "reason"],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{20}$"
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "missing-executable",
                "script-execution",
                "every-minute",
                "persistent-at-load",
                "downloads-location",
                "temporary-location",
                "world-writable",
                "unsigned-root-daemon",
                "download-pipe-shell",
                "attribution-mismatch"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
